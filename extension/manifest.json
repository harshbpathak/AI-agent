{
  "manifest_version": 3,
  "name": "EvolveOS Browser Agent",
  "version": "1.0.0",
  "description": "Locally records and replays browser workflows for EvolveOS.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "EvolveOS Browser Agent" }
}
